# ==============================================================
# Configuracion del servidor
# ==============================================================
PORT=4000
NODE_ENV=development

# Origen permitido para CORS (URL del frontend)
CORS_ORIGIN=http://localhost:5173

# ==============================================================
# Base de datos PostgreSQL
# Estos valores se usan en local con Postgres/Docker mientras
# el companero de infraestructura crea la instancia en AWS (RDS).
# Cuando la BD de AWS este lista, solo se reemplazan estos valores
# (o se define DATABASE_URL) sin tocar el codigo de la aplicacion.
# ==============================================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gladiator_fitness
DB_USER=postgres
DB_PASSWORD=postgres
DB_DIALECT=postgres

# Alternativa: si se define DATABASE_URL, tiene prioridad sobre
# las variables individuales de arriba (formato usado por RDS/Heroku/etc).
# Ejemplo AWS RDS:
# DATABASE_URL=postgres://usuario:password@nombre-instancia.xxxxxxxx.us-east-1.rds.amazonaws.com:5432/gladiator_fitness
# DATABASE_URL=

# RDS normalmente requiere SSL. Poner en "true" al conectar a AWS.
DB_SSL=false

# ==============================================================
# Seguridad
# ==============================================================
JWT_SECRET=cambia_este_valor_por_un_secreto_largo_y_aleatorio
JWT_EXPIRES_IN=8h

# Credenciales del administrador inicial (usadas por "npm run seed")
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=Admin123!
